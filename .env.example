# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.

# Base de datos PostgreSQL
DB_USER=postgres
DB_PASS=tu_password_aqui

# Google OAuth2 — Client ID de Google Cloud Console
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# JWT — clave secreta en Base64, mínimo 256 bits
# Generar con: openssl rand -base64 64
JWT_SECRET=genera_una_clave_segura_aqui

# CORS — orígenes permitidos (separados por coma, sin espacios)
FRONTEND_URLS=http://localhost:5500,http://127.0.0.1:5500
